{
  "name": "linkdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firefox extension: a desktop of link icons on the new tab page.",
  "license": "MIT",
  "author": "edsdck",
  "repository": {
    "type": "git",
    "url": "https://github.com/edsdck/linkdesk.git"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/smoke.e2e.js",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "start": "web-ext run --source-dir extension",
    "icons": "node scripts/render-icons.mjs",
    "screenshots": "node scripts/store-screenshots.mjs",
    "check": "npm test && npm run lint && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "web-ext": "^8.0.0"
  }
}
